# HTCondor submit file: SGD nosigma training runs, one per learning-rate tag.
#     condor_submit_bid <BID> condor/run_nosigma_sgd_lrsweep.sub
# lrtag -> init_lr (see lrs() in src/run_nosigma.py): 40 -> 2e-3, 42 -> 4e-3, 43 -> 8e-3.

initialdir   = /fast/jtaraz/MISC/ModeDecomposition-DeepONets
executable   = condor/run_nosigma_sgd.sh
arguments    = $(lrtag)
getenv       = True

output       = condor/logs/run_nosigma_sgd_lr$(lrtag).$(ClusterId).$(ProcId).out
error        = condor/logs/run_nosigma_sgd_lr$(lrtag).$(ClusterId).$(ProcId).err
log          = condor/logs/run_nosigma_sgd_lr$(lrtag).$(ClusterId).$(ProcId).log

request_cpus   = 4
request_memory = 8192
request_disk   = 4096
request_gpus   = 0

queue lrtag in (40 42 43)
