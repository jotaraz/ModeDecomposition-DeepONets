# HTCondor fan-out: one job per model config in src/run_grid.py, all submitted
# together so they run IN PARALLEL across compute nodes.
#
# Each job gets its process index via $(Process); the wrapper passes it to
# run_grid.py, which runs exactly CONFIGS[$(Process)]. Every config writes to a
# distinct data/nets/<stem>/ dir, so there are no output collisions.
#
#   condor_submit_bid <BID> condor/run_grid.sub
#
# NOTE: the queue count below must equal `python run_grid.py --count`.
# Current grid = 3 sizes x 2 widths x {DON, SVD} = 12.

initialdir   = /fast/jtaraz/MISC/ModeDecomposition-DeepONets
executable   = condor/run_grid.sh
arguments    = $(Process)
getenv       = True

output       = condor/logs/run_grid.$(ClusterId).$(Process).out
error        = condor/logs/run_grid.$(ClusterId).$(Process).err
log          = condor/logs/run_grid.$(ClusterId).$(Process).log

# --- Per-job resources (CPU-only, no GPU) ----------------------------------
# One width<=500 depth<=10 JAX MLP over 4000 epochs. Memory/disk (MB) are
# modest even for the largest config; 8192 MB is comfortable headroom.
request_cpus   = 4
request_memory = 8192
request_disk   = 4096
request_gpus   = 0

queue 12
