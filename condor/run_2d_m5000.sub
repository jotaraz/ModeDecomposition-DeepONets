# HTCondor submit file: the 6 best-min-test-error hyperparameter sets, retrained
# at the ORIGINAL width w=335 on the NEW 5000-sample datasets (num_data=5000).
#
# Companion to condor/run_2d_width.sub (same 6 sets, w in {100,200,500}, on the
# 1000-sample data). Together with the existing w=335 / 1000-sample baselines
# these isolate the two axes:
#     w=335, numd1000  -> baseline (already trained, run_2d_sweep2.sub)
#     w=335, numd5000  -> this file: effect of 5x more data, width held fixed
#     w!=335, numd1000 -> run_2d_width.sub: effect of width, data held fixed
#
# Everything else matches run_2d_sweep2.sub: Nep4000, vtag0, lrAdam32 =
# 1e-4/0.95, t0.004, exp0.0, unstacked, adaptiveLR0, momentum1.
#
# NOTE 4500 train samples per full-batch step instead of 900, so roughly 5x the
# per-epoch cost of the baselines, and a much larger SVD at startup.
#
#   condor_submit_bid <BID> condor/run_2d_m5000.sub

initialdir   = /fast/jtaraz/MISC/ModeDecomposition-DeepONets
executable   = condor/run_2d_cfg.sh
getenv       = True

output = condor/logs/m5000_2d.$(ClusterId).$(ProcId).out
error  = condor/logs/m5000_2d.$(ClusterId).$(ProcId).err
log    = condor/logs/m5000_2d.$(ClusterId).$(ProcId).log

request_cpus   = 4
request_memory = 16384
request_disk   = 8192
request_gpus   = 0

# [0] SVD trunk, heat2d_sine_nx64_K8_D1_m5000, N=50 d=15 w=335 numd5000
arguments = 4000 0 15 335 50 0 heat2d_sine_nx64_K8_D1_m5000 32 0.0001 0.95 5000 0 1 t0.004 1.0 0.0 1 0 0 1
queue
# [1] learned trunk, heat2d_sine_nx64_K8_D1_m5000, N=150 d=10 w=335 numd5000
arguments = 4000 0 10 335 150 0 heat2d_sine_nx64_K8_D1_m5000 32 0.0001 0.95 5000 -1 0 t0.004 First 0.0 1 0 0 1
queue
# [2] SVD trunk, heat2d_grf_nx64_l0.1-0.2_D1_m5000, N=200 d=15 w=335 numd5000
arguments = 4000 0 15 335 200 0 heat2d_grf_nx64_l0.1-0.2_D1_m5000 32 0.0001 0.95 5000 0 1 t0.004 1.0 0.0 1 0 0 1
queue
# [3] learned trunk, heat2d_grf_nx64_l0.1-0.2_D1_m5000, N=150 d=10 w=335 numd5000
arguments = 4000 0 10 335 150 0 heat2d_grf_nx64_l0.1-0.2_D1_m5000 32 0.0001 0.95 5000 -1 0 t0.004 First 0.0 1 0 0 1
queue
# [4] SVD trunk, heat2d_grf_nx64_l0.05_D1_m5000, N=150 d=15 w=335 numd5000
arguments = 4000 0 15 335 150 0 heat2d_grf_nx64_l0.05_D1_m5000 32 0.0001 0.95 5000 0 1 t0.004 1.0 0.0 1 0 0 1
queue
# [5] learned trunk, heat2d_grf_nx64_l0.05_D1_m5000, N=150 d=15 w=335 numd5000
arguments = 4000 0 15 335 150 0 heat2d_grf_nx64_l0.05_D1_m5000 32 0.0001 0.95 5000 -1 0 t0.004 First 0.0 1 0 0 1
queue
