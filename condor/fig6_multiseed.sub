# Seed-averaged Figure 6: mean over the ten synthv09082026 seeds (clusters
# 17447660 for v0 and 17447701 for v1..v9), drawn both with and without the
# +/- 1 std band.
#
#   condor_submit_bid 100 condor/fig6_multiseed.sub
#
# Reads only log.txt / log_modes.txt from the forty net directories; no dataset
# is loaded. The script imports don_code (hence jax) and pgf+usetex shells out
# to pdflatex, so it needs a compute node and real scratch, not the 1 GB /tmp.

initialdir   = /fast/jtaraz/MISC/ModeDecomposition-DeepONets
executable   = condor/fig6_multiseed.sh
arguments    =
getenv       = True

output       = condor/logs/fig6_multiseed.$(ClusterId).$(ProcId).out
error        = condor/logs/fig6_multiseed.$(ClusterId).$(ProcId).err
log          = condor/logs/fig6_multiseed.$(ClusterId).$(ProcId).log

request_cpus   = 4
request_memory = 8192
request_disk   = 4096
request_gpus   = 0

queue
