# HTCondor submit file: sigma-weighted SGD training runs, one job per learning-rate tag.
#     condor_submit_bid <BID> condor/run_normal_sgd_sweep.sub
# lr tags (see lrs() in src/run_nosigma_sgd.py):
#   33 -> 2e-4   35 -> 4e-4   40 -> 2e-3   42 -> 4e-3   43 -> 8e-3
#   44 -> 1e-2   45 -> 2e-2   46 -> 4e-2   47 -> 8e-2

initialdir   = /fast/jtaraz/MISC/ModeDecomposition-DeepONets
executable   = condor/run_normal_sgd.sh
arguments    = $(lrtag)
getenv       = True

output       = condor/logs/run_normal_sgd_sweep_lr$(lrtag).$(ClusterId).$(ProcId).out
error        = condor/logs/run_normal_sgd_sweep_lr$(lrtag).$(ClusterId).$(ProcId).err
log          = condor/logs/run_normal_sgd_sweep_lr$(lrtag).$(ClusterId).$(ProcId).log

request_cpus   = 4
request_memory = 8192
request_disk   = 4096
request_gpus   = 0

queue lrtag in (33 35 40 42 43 44 45 46 47)
