# Calibration: time one short (Nep500) run per representative net size, so the
# full 10-seed sweep can be costed. Per-epoch cost is constant, so wall time for
# a real Nep<N> run is roughly (measured - startup) * N/500 + startup.
#
#   condor_submit_bid 100 condor/calib2.sub
#
# Uses vtag=99 so the resulting directories can never collide with the v0..v9
# sweep; they are throwaway and get deleted after reading the timings.

initialdir   = /fast/jtaraz/MISC/ModeDecomposition-DeepONets
executable   = condor/train_one.sh
arguments    = $(args)
getenv       = True

output       = condor/logs/calib2.$(ClusterId).$(ProcId).out
error        = condor/logs/calib2.$(ClusterId).$(ProcId).err
log          = condor/logs/calib2.$(ClusterId).$(ProcId).log

request_cpus   = 4
request_memory = 16384
request_disk   = 8192
request_gpus   = 0

queue args from condor/calib2_args.txt
