# ---------------------------------------------------------------------------
# HTCondor submit file: identify the discretization that produced
# kdvnx401_dt0.0001_nc5_m5000 by scoring scheme candidates against the stored
# solutions.  Reads data/datasets/ read-only; writes only into this workdir.
#
#     condor_submit_bid 25 kdv_validate.sub
# ---------------------------------------------------------------------------

initialdir   = /fast/jtaraz/MISC/kdv_finegrid
executable   = kdv_regen.sh
arguments    = validate --nsamples 8 --tags 10 1999 --wraps wrap401 --stencils compact --schemes rk4 --h-divs 400 401 399 --profile --top 20

getenv       = True

output       = logs/kdv_validate.$(ClusterId).$(ProcId).out
error        = logs/kdv_validate.$(ClusterId).$(ProcId).err
log          = logs/kdv_validate.$(ClusterId).$(ProcId).log

# CPU-only. The integration itself is negligible (8 samples x 401 points x 2000
# RK4 steps x 8 candidate schemes); the cost is np.loadtxt on the 51 MB _U text
# files, which is single-threaded and I/O bound.
request_cpus   = 4
request_memory = 16384
request_disk   = 8192
request_gpus   = 0

queue
